(defun wayland-test-child (parent &rest parameters)
  (make-frame (append parameters
                      `((parent-frame . ,parent) (minibuffer . nil)
                        (width . 20) (height . 8)
                        (tool-bar-lines . 0) (menu-bar-lines . 0)
                        (tab-bar-lines . 0)))))

(ert-deftest wayland-test-child-frames ()
  (wayland-test-text-frame)
  (redisplay t)
  (wayland-test-send "ready" (wayland-test-capture))
  (wayland-test-next "create")
  (let* ((root wayland-test-frame)
         (child (wayland-test-child root '(left . 17) '(top . 23))))
    (should (eq (frame-parent child) root))
    (with-selected-frame child
      (wayland-test-text-frame)
      (switch-to-buffer (get-buffer-create "*Wayland child*"))
      (wayland-test-render-text "Initial child content"))
    ;; Finish redisplay after restoring the selected frame.  Otherwise
    ;; the next redisplay can still repaint the parent after setup.
    (redisplay t)
    (wayland-test-send "created" (vconcat (wayland--dump-frame nil child)))
    (wayland-test-next "redraw")
    (with-current-buffer (window-buffer (frame-selected-window child))
      (wayland-test-render-text "Only the child's content changed"))
    (wayland-test-send "redrawn")
    (wayland-test-next "block-parent")
    (wayland--debug-fail-pool t root)
    (wayland-test-send "blocked")
    (wayland-test-next "move")
    (dotimes (i 20)
      (set-frame-position child (- -20 i) (- -10 i)))
    (wayland-test-send "moved")
    (wayland-test-next "unblock-parent")
    (wayland--debug-fail-pool nil root)
    (redisplay t)
    (wayland-test-send "unblocked")
    (wayland-test-next "hide")
    (make-frame-invisible child t)
    (wayland-test-send "hidden")
    (wayland-test-next "show")
    (set-frame-position child 31 41)
    (make-frame-visible child)
    (redisplay t)
    (wayland-test-send "shown")
    (wayland-test-next "delete")
    (let ((survivor (make-frame '((visibility . nil)))))
      (unwind-protect
          (progn
            (delete-frame root t)
            (should-not (frame-live-p child))
            (wayland-test-send "deleted"))
        (make-frame-visible survivor)))
    (should (wayland-test-frames-collected-p))
    (wayland-test-next "done")))

(ert-deftest wayland-test-child-pointer ()
  ;; The pointer highlights text in a child frame and is blanked there,
  ;; then the child is deleted under it.
  (wayland-test-text-frame)
  (redisplay t)
  (wayland-test-send "ready" (wayland-test-capture))
  (wayland-test-next "create")
  (let ((child (wayland-test-child wayland-test-frame
                                   '(left . 20) '(top . 20))))
    (with-selected-frame child
      (switch-to-buffer (generate-new-buffer "*Wayland child*"))
      (setq-local mode-line-format nil)
      (insert (propertize "Highlighted text" 'mouse-face 'highlight)))
    (redisplay t)
    (wayland-test-send "created" (wayland-test-surface-id child))
    (wayland-test-send-absolute)
    (wayland-test-next "blank")
    (should (wayland-test-metrics :mouse-face-active))
    (let ((make-pointer-invisible t))
      (with-selected-frame child
        (self-insert-command 1 ?x)))
    (wayland-test-send "blanked")
    (wayland-test-next "delete")
    (should (wayland-test-metrics :mouse-face-active))
    (delete-frame child)
    (should-not (wayland-test-metrics :mouse-face-active))
    (setq child nil)
    ;; Free the frame, so a stale highlight would use freed memory.
    (garbage-collect)
    (wayland-test-send "deleted"))
  (wayland-test-next "blank-root")
  (let ((make-pointer-invisible t))
    (self-insert-command 1 ?x))
  (wayland-test-send "blanked")
  (wayland-test-next "done"))

(defun wayland-test-send-absolute ()
  "Answer the runner's \"absolute\" with `mouse-absolute-pixel-position'."
  (wayland-test-next "absolute")
  ;; Handle the motion the runner sent first.
  (input-pending-p)
  (let ((position (mouse-absolute-pixel-position)))
    (wayland-test-send "absolute" (vector (car position) (cdr position)))))

(ert-deftest wayland-test-child-drag ()
  ;; Dragging a child frame moves it under a held button.
  (wayland-test-text-frame)
  (redisplay t)
  (wayland-test-send "ready" (wayland-test-capture))
  (wayland-test-next "create")
  (let ((child (wayland-test-child wayland-test-frame
                                   '(left . 20) '(top . 20))))
    (redisplay t)
    (wayland-test-send "created" (wayland-test-surface-id child))
    (wayland-test-send-absolute)
    (wayland-test-next "move")
    (set-frame-position child 60 40)
    (redisplay t)
    (wayland-test-send "moved")
    (wayland-test-send-absolute))
  (wayland-test-next "done"))

(defun wayland-test-frames-collected-p ()
  "Whether deleted frames, child and top-level, are garbage collected.
A frame whose faces were never freed stays reachable from its realized
fontsets.  Conservative stack scanning may still keep the last one."
  (let ((frames (make-hash-table :test 'eq :weakness 'key)))
    (dotimes (i 4)
      (let ((frame (if (zerop (% i 2))
                       (wayland-test-child (selected-frame))
                     (make-frame '((visibility . nil))))))
        (redisplay t)
        (delete-frame frame)
        (puthash frame t frames)))
    (garbage-collect)
    (<= (hash-table-count frames) 1)))

(ert-deftest wayland-test-child-no-subcompositor ()
  (redisplay t)
  (wayland-test-send "ready" (wayland-test-capture))
  (wayland-test-next "create")
  (should-error (wayland-test-child wayland-test-frame))
  (wayland-test-send "rejected")
  (wayland-test-next "done"))

(defun wayland-test-surface-id (frame)
  (car (wayland--dump-frame nil frame)))

(defun wayland-test-child-buffer (frame)
  (with-selected-frame frame
    (switch-to-buffer (generate-new-buffer "*Wayland child*"))
    (setq-local mode-line-format nil cursor-type 'box)
    (insert "Nested child frame")))

(ert-deftest wayland-test-child-hierarchy ()
  (wayland-test-text-frame)
  (redisplay t)
  (wayland-test-send "ready" (wayland-test-capture))
  (wayland-test-next "create")
  (let* ((root wayland-test-frame)
         (child (wayland-test-child root '(left . 17) '(top . 21)))
         (grand (wayland-test-child child '(left . 11) '(top . 13)))
         (sibling (wayland-test-child child '(left . 15) '(top . 17))))
    (mapc #'wayland-test-child-buffer (list child grand sibling))
    (lower-frame child)
    (frame-restack sibling child)
    (redisplay t)
    (wayland-test-send "created"
                       (vconcat (mapcar #'wayland-test-surface-id
                                        (list child grand sibling))))
    (dolist (operation '("raise-sibling" "lower-sibling"
                         "above-sibling" "below-sibling"))
      (wayland-test-next operation)
      (pcase operation
        ("raise-sibling" (raise-frame sibling))
        ("lower-sibling" (lower-frame sibling))
        ("above-sibling" (set-frame-parameter sibling 'z-group 'above))
        ("below-sibling" (set-frame-parameter sibling 'z-group 'below)))
      (wayland-test-send operation))
    (wayland-test-next "focus")
    (select-frame-set-input-focus grand)
    (with-selected-frame grand
      (goto-char (point-min))
      (redisplay t)
      (let ((xy (posn-object-x-y (posn-at-point)))
            (edges (window-inside-pixel-edges)))
        (wayland-test-send "focused"
                           (vector (+ (car xy) (nth 0 edges))

                                   (+ (cdr xy) (nth 1 edges))
                                   (frame-pixel-width grand)
                                   (frame-pixel-width child)))))
    (wayland-test-next "input")
    (let ((event (read-event nil nil 2)))
      (while (and (consp event) (eq (car event) 'switch-frame))
        (setq event (read-event nil nil 2)))
      (should (eq last-event-frame grand))
      (should (eq event ?z)))
    (wayland-test-send "typed")
    (wayland-test-next "pointer")
    (let ((event (read-event nil nil 2)))
      (while (and (consp event) (eq (car event) 'switch-frame))
        (setq event (read-event nil nil 2)))
      (should (eq (event-basic-type event) 'mouse-1))
      (should (eq (window-frame (posn-window (event-start event))) grand)))
    (wayland-test-send "clicked")
    (wayland-test-next "hide")
    (make-frame-invisible child t)
    (wayland-test-wait (lambda () (read-event nil nil 0.05)
                         (eq (frame-focus-state root) t)))
    (should-not (frame-focus-state grand))
    (should-not (frame-visible-p grand))
    (wayland-test-send "hidden")
    (wayland-test-next "promote")
    (make-frame-visible child)
    (modify-frame-parameters child '((parent-frame . nil)))
    (should (eq (frame-parent grand) child))
    (redisplay t)
    (wayland-test-send "promoted" (wayland-test-surface-id child))
    (wayland-test-next "demote")
    (modify-frame-parameters child `((parent-frame . ,root)))
    (redisplay t)
    (wayland-test-send "demoted" (wayland-test-surface-id child))
    (wayland-test-next "reparent")
    (modify-frame-parameters grand `((parent-frame . ,root)))
    (redisplay t)
    (wayland-test-send "reparented" (wayland-test-surface-id grand))
    (wayland-test-next "minibuffer")
    (let* ((mini (make-frame '((minibuffer . only))))
           (minibuffer (minibuffer-window mini))
           (owner (make-frame `((minibuffer . ,minibuffer)))))
      ;; The shared deletion path retains a promoted minibuffer only
      ;; when another frame still uses it.
      (make-frame `((minibuffer . ,minibuffer)))
      (modify-frame-parameters mini `((parent-frame . ,owner)))
      (let ((before (wayland-test-surface-id mini)))
        (delete-frame owner t)
        (should (frame-live-p mini))
        (should-not (frame-parent mini))
        (redisplay t)
        (wayland-test-send "minibuffer"
                           (vector before (wayland-test-surface-id mini)))))
    (wayland-test-next "done")))

(defun wayland-test-child-scaled ()
  (wayland-test-text-frame)
  (redisplay t)
  (wayland-test-send "ready" (wayland-test-capture))
  (wayland-test-next "scale")
  (wayland-test-wait
   (lambda () (redisplay t) (= (frame-scale-factor) 2)))
  (wayland-test-send "scaled")
  (wayland-test-next "create")
  (let ((frame-resize-pixelwise t)
        (window-min-width 1)
        (window-min-height 1)
        (child (wayland-test-child wayland-test-frame
                                   '(left . 40) '(top . 30)
                                   '(left-fringe . 0) '(right-fringe . 0))))
    (wayland-test-child-buffer child)
    (set-frame-size child 157 95 t)
    (redisplay t)
    (wayland-test-send "created" (wayland-test-surface-id child))
    (wayland-test-next "measure")
    (redisplay t)
    (wayland-test-send "measured"
                       (vector (frame-pixel-width child)
                               (frame-pixel-height child)
                               (frame-char-width child)))
    (wayland-test-next "padding")
    (should-not (read-event nil nil 0.15))
    (wayland-test-send "padding")
    (wayland-test-next "done")))

(ert-deftest wayland-test-child-no-viewporter ()
  (wayland-test-child-scaled))

(ert-deftest wayland-test-child-no-fractional ()
  (wayland-test-child-scaled))

(ert-deftest wayland-test-child-mixed-scale ()
  (wayland-test-text-frame)
  (redisplay t)
  (wayland-test-send "ready" (wayland-test-capture))
  (wayland-test-next "create")
  (let* ((root wayland-test-frame)
         (child (wayland-test-child root '(left . 40) '(top . 30)))
         (other (make-frame nil))
         (grand (wayland-test-child child '(left . 16) '(top . 12))))
    (mapc #'wayland-test-child-buffer (list child grand))
    (redisplay t)
    (wayland-test-send "created"
                       (vconcat (mapcar #'wayland-test-surface-id
                                        (list child grand other))))
    (dolist (scale '(1.25 1.5 2.0))
      (wayland-test-next "scale")
      (wayland-test-wait
       (lambda ()
         (redisplay t)
         (and (= (frame-scale-factor root) scale)
              (= (frame-scale-factor child) scale)
              (= (frame-scale-factor grand) scale))))
      (should (= (frame-scale-factor other) 1))
      (wayland-test-send "scaled"
                         (vector (frame-pixel-width child)
                                 (frame-pixel-height child))))
    (wayland-test-next "done")))

(defun wayland-test-next-child-capture (phase)
  ;; Give the GUI event loop a chance to run while the runner captures
  ;; the current image. PGTK's draw callback is scheduled by GTK.
  (while (not (string-search "\n" wayland-test-input))
    (read-event nil nil 0.05))
  (wayland-test-next phase))

(ert-deftest wayland-test-child-parity ()
  (let ((root wayland-test-frame)
        (frame-resize-pixelwise t)
        (size (mapcar #'string-to-number
                      (split-string (getenv "EMACS_WAYLAND_TEST_SIZE")))))
    (wayland-test-text-frame)
    (scroll-bar-mode -1)
    (erase-buffer)
    (modify-frame-parameters root '((background-color . "#ffffff")
                                    (internal-border-width . 0)))
    (wayland-test-wait
     (lambda ()
       (redisplay t)
       (equal size (list (frame-pixel-width root) (frame-pixel-height root)))))
    (wayland-test-send "ready" (symbol-name window-system))
    (wayland-test-next "create")
    (let ((child (wayland-test-child
                  root '(width . 0) '(height . 0) '(visibility . nil)
                  '(background-color . "#d4762a") '(cursor-type . nil)
                  '(internal-border-width . 0) '(left-fringe . 0)
                  '(right-fringe . 0) '(no-accept-focus . t)
                  '(no-focus-on-map . t) '(undecorated . t))))
      (with-selected-frame child
        (switch-to-buffer (generate-new-buffer "*Wayland popup scene*"))
        (setq-local mode-line-format nil cursor-type nil)
        (set-face-background 'default "#d4762a" child))
      (set-frame-size-and-position-pixelwise child 240 180 120 90)
      (make-frame-visible child)
      (redraw-frame child)
      (redisplay t)
      (wayland-test-send "created" (vector (frame-pixel-width child)
                                          (frame-pixel-height child)))
      (wayland-test-next-child-capture "move")
      (dotimes (i 10)
        (set-frame-position child (+ 210 i) (+ 210 i))
        (redisplay t))
      (set-frame-position child 240 180)
      (set-frame-size child 270 210 t)
      (redisplay t)
      (wayland-test-send "moved" (vector (frame-pixel-width child)
                                        (frame-pixel-height child)))
      (wayland-test-next-child-capture "hide")
      (make-frame-invisible child t)
      (redisplay t)
      (wayland-test-send "hidden")
      (wayland-test-next-child-capture "done"))))

(ert-deftest wayland-test-selection ()
  (wayland-test-text-frame)
  (redisplay t)
  (wayland-test-send "ready" (wayland-test-capture))
  (wayland-test-next "local-primary")
  (gui-set-selection 'PRIMARY "local only")
  (should (equal (gui-get-selection 'PRIMARY 'UTF8_STRING) "local only"))
  (should (gui-backend-selection-owner-p 'PRIMARY))
  (wayland-test-send "local-primary")
  (wayland-test-next "open-child")
  (let ((child (wayland-test-child wayland-test-frame)))
    (redisplay t)
    (wayland-test-send "child" (wayland-test-surface-id child))
    (wayland-test-next "publish-a")
    (should (eq (read-event nil nil 2) ?a))
    (with-selected-frame child
      (gui-set-selection 'CLIPBOARD "first")
      (should (gui-backend-selection-owner-p 'CLIPBOARD)))
    (wayland-test-send "published-a")
    (wayland-test-next "close-child")
    (delete-frame child))
  (should (equal (gui-get-selection 'CLIPBOARD 'UTF8_STRING) "first"))
  (wayland-test-send "child-closed")
  (wayland-test-next "publish-b")
  (gui-set-selection 'CLIPBOARD "second")
  (should (equal (gui-get-selection 'CLIPBOARD 'UTF8_STRING) "second"))
  (wayland-test-send "published-b")
  (wayland-test-next "unfocused")
  (gui-set-selection 'CLIPBOARD "unfocused")
  (should (equal (gui-get-selection 'CLIPBOARD 'UTF8_STRING) "second"))
  (wayland-test-send "unfocused")
  (wayland-test-next "foreign")
  (should-not (gui-backend-selection-owner-p 'CLIPBOARD))
  (should (memq 'UTF8_STRING (append (gui-get-selection 'CLIPBOARD 'TARGETS) nil)))
  (should (equal (gui-get-selection 'CLIPBOARD 'UTF8_STRING) "external 日本語"))
  (wayland-test-send "foreign")
  (wayland-test-next "unavailable")
  (should-not (gui-get-selection 'CLIPBOARD 'UTF8_STRING))
  (wayland-test-send "unavailable")
  (wayland-test-next "timeout")
  (let ((wayland-selection-timeout 150))
    (should-not (gui-get-selection 'CLIPBOARD 'UTF8_STRING)))
  (wayland-test-send "timed-out")
  (wayland-test-next "read-quit")
  (should (eq (condition-case nil
                  (let ((inhibit-quit nil))
                    (gui-get-selection 'CLIPBOARD 'UTF8_STRING))
                (quit 'quit))
              'quit))
  (wayland-test-send "read-quit")
  (wayland-test-next "publish-slow")
  (let ((size (* 2 1024 1024))
        (wayland-selection-timeout 500))
    (gui-set-selection 'CLIPBOARD (make-string size ?a))
    (wayland-test-send "published-slow" (vector size wayland-selection-timeout))
    (wayland-test-next "slow-done"))
  (wayland-test-next "done"))

(ert-deftest wayland-test-clipboard-pipes ()
  (wayland-test-text-frame)
  (redisplay t)
  (wayland-test-send "ready" (wayland-test-capture))
  (dolist (size '(1024 1048576 67108864))
    (wayland-test-next "publish")
    (should (eq (read-event nil nil 2) ?a))
    (gui-set-selection 'CLIPBOARD (make-string size ?a))
    (should (gui-backend-selection-owner-p 'CLIPBOARD))
    (wayland-test-send "published")
    (wayland-test-next "read")
    (wayland-test-wait
     (lambda () (and (not (gui-backend-selection-owner-p 'CLIPBOARD))
                     (gui-backend-selection-exists-p 'CLIPBOARD))))
    (let ((received (gui-get-selection 'CLIPBOARD 'UTF8_STRING)))
      (should (= (length received) size))
      (wayland-test-send "read" (secure-hash 'sha256 received))))
  (wayland-test-next "primary")
  (should (eq (read-event nil nil 2) ?a))
  (gui-set-selection 'PRIMARY "primary from Emacs")
  (wayland-test-send "primary")
  (wayland-test-next "read-primary")
  (wayland-test-wait
   (lambda () (and (not (gui-backend-selection-owner-p 'PRIMARY))
                   (gui-backend-selection-exists-p 'PRIMARY))))
  (should (equal (gui-get-selection 'PRIMARY 'UTF8_STRING) "primary from wl-copy"))
  (wayland-test-send "read-primary")
  (wayland-test-next "done"))

(ert-deftest wayland-test-popup-menu ()
  (let* ((simple (list "Choices" (list "Only pane" '("First" . first)
                                      '("Second" . second))))
         (panes '("Choices" ("First pane" ("First" . first))
                  ("Second pane" ("Second" . second))))
         (keymap (make-sparse-keymap "Choices"))
         (nested (make-sparse-keymap "Submenu"))
         expected-labels metadata candidates
         (position (list '(0 0) wayland-test-frame))
         (click (list 'mouse-1 (list (selected-window) 1 '(10 . 10) 0))))
    (should (display-popup-menus-p wayland-test-frame))
    (define-key nested [action] '(menu-item "Action" ignore :keys "C-c a"))
    (define-key nested [disabled] '(menu-item "Disabled" ignore :enable nil))
    (define-key keymap [nested] (list 'menu-item "Nested" nested))
    (define-key keymap [separator] '(menu-item "--"))
    (cl-letf (((symbol-function 'completing-read)
               (lambda (prompt table &rest _args)
                 (should (equal prompt "Choices: "))
                 (let ((labels (all-completions "" table)))
                   (should (equal labels expected-labels))
                   (setq candidates labels)
                   (setq metadata (cdr (completion-metadata "" table nil)))
                   (car labels)))))
      (should-not (x-popup-menu nil simple))
      (setq expected-labels '("First" "Second"))
      (should (eq (x-popup-menu position simple) 'first))
      ;; Menu order, and items at the top under the menu's title.
      (should (eq (alist-get 'display-sort-function metadata) #'identity))
      (should (equal (funcall (alist-get 'group-function metadata) "First" nil)
                     "Choices"))
      (setq expected-labels '("First pane > First" "Second pane > Second"))
      (should (eq (x-popup-menu position panes) 'first))
      ;; Each item shows under its submenu with its own name.
      (let ((group (alist-get 'group-function metadata)))
        (should (equal (funcall group "Second pane > Second" nil) "Second pane"))
        (should (equal (funcall group "Second pane > Second" t) "Second")))
      (setq expected-labels '("Nested > Action"))
      (should (equal (x-popup-menu position keymap) '(nested action)))
      ;; The item's keyboard equivalent comes with its label and is
      ;; its annotation.
      (should (equal (get-text-property 0 'wayland-menu-keys (car candidates))
                     "C-c a"))
      (should (string-search
               "C-c a" (funcall (alist-get 'annotation-function metadata)
                                (car candidates)))))
    (cl-letf (((symbol-function 'completing-read)
               (lambda (&rest _) (signal 'quit nil))))
      (should (eq (condition-case nil (x-popup-menu position simple)
                    (quit 'quit))
                  'quit))
      (should-not (x-popup-menu click simple))))
  (redisplay t)
  (wayland-test-send "ready")
  (wayland-test-next "done"))

(ert-deftest wayland-test-activation ()
  (let ((load-prefer-newer t))
    (require 'server))
  (setq server-name "m3-activation")
  (server-start)
  (redisplay t)
  (wayland-test-send "ready" (vector (wayland-test-surface-id wayland-test-frame)
                                    (expand-file-name server-name
                                                      server-socket-dir)))
  (wayland-test-next "without-serial")
  (raise-frame)
  (wayland-test-send "without-serial")
  (wayland-test-next "request")
  (make-frame '((name . "M3 activation target")))
  (let ((target (car (frame-list))))
    (select-frame-set-input-focus target)
    (redisplay t)
    (wayland-test-send "requested" (wayland-test-surface-id target)))
  (dolist (operation '("title" "replace-role"))
    (wayland-test-next operation)
    (let ((target (make-frame `((visibility . nil)
                                (activation-token . ,operation)))))
      (raise-frame target)
      (set-frame-parameter target 'title "First title")
      (set-frame-parameter target 'title "Second title")
      (when (equal operation "replace-role")
        (set-frame-parameter target 'parent-frame wayland-test-frame)
        (set-frame-parameter target 'parent-frame nil))
      (make-frame-visible target)
      (redisplay t)
      (wayland-test-send operation (wayland-test-surface-id target))))
  (wayland-test-next "done"))
